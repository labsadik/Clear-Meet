VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Supabase Edge Functions use these as server secrets, not VITE_* variables.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are normally injected by Supabase.
# VIDEOSDK_API_KEY=YOUR_VIDEOSDK_API_KEY
# VIDEOSDK_SECRET=YOUR_VIDEOSDK_SECRET
